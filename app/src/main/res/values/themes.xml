<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base app theme — used by the Activity window before Compose takes over -->
    <style name="Theme.NammaYantra" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#4F5D95</item>
        <item name="colorPrimaryVariant">#3A4570</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#A88B5E</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:windowBackground">#F7F7FB</item>
        <item name="android:statusBarColor">#4F5D95</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
    </style>

    <!-- Splash screen theme — wraps the base theme -->
    <style name="Theme.NammaYantra.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#4F5D95</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.NammaYantra</item>
    </style>

</resources>
